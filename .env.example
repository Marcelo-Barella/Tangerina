# Tangerina Discord Bot - Environment Variables Example

# =============================================================================
# VARIÁVEIS OBRIGATÓRIAS
# =============================================================================

# Token do bot do Discord (obrigatório)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# =============================================================================
# VARIÁVEIS DE CONFIGURAÇÃO DO CHATBOT
# =============================================================================

# Provedor de IA a ser usado - 'zhipu' (padrão), 'openai' ou 'gemini'
MODEL_PROVIDER=zhipu

# Chave da API ZhipuAI GLM (obrigatório se MODEL_PROVIDER=zhipu)
ZHIPU_API_KEY=your_zhipu_api_key_here

# Chave da API OpenAI (obrigatório se MODEL_PROVIDER=openai; também usada para Whisper API)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI-compatible local LLM (Ollama / LM Studio). When set, WHISPER_PROVIDER defaults to sidecar.
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Modelo OpenAI a ser usado (opcional, padrão: gpt-4o-mini)
# Opções: gpt-4o-mini, gpt-4o, etc.
OPENAI_MODEL=gpt-4o-mini


# Chave da API Google Gemini (obrigatório se MODEL_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# VARIÁVEIS OPCIONAIS
# =============================================================================


# Nível de log (opcional, padrão: INFO)
LOG_LEVEL=INFO

# Client ID do Spotify Developer App
SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Client Secret do Spotify Developer App
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Provedor TTS: 'elevenlabs', 'piper' ou 'omnivoice' (padrão: elevenlabs)
# Listening-mode voice replies use this same provider.
TTS_PROVIDER=elevenlabs

# Chave da API ElevenLabs para TTS
ELEVEN_API_KEY=your_elevenlabs_api_key_here

# URL do sidecar OmniVoice TTS (ex.: http://omnivoice-tts:5003 ou http://localhost:5003)
OMNIVOICE_API_URL=http://localhost:5003

# Timeout HTTP do OmniVoice em segundos (padrão: 90)
OMNIVOICE_TIMEOUT=90

OMNIVOICE_INSTRUCT=female, portuguese accent
OMNIVOICE_PRECISION=int8

# Provedor de transcrição: zhipu | openai | openai-api | sidecar
# Vazio + cloud OPENAI_API_KEY → openai-api
# Vazio + OPENAI_BASE_URL (local LLM) → sidecar
# Vazio sem chave → sidecar
# WHISPER_PROVIDER=

# Sidecar local engine: faster-whisper (default) | openai-whisper
# WHISPER_LOCAL_ENGINE=faster-whisper
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_API_URL=http://whisper-asr:5002
# WHISPER_USE_OPENAI_API=1

# Local voice stack example (wake + faster-whisper + local LLM + Piper):
# MODEL_PROVIDER=openai
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2
# WHISPER_PROVIDER=sidecar
# WHISPER_LOCAL_ENGINE=faster-whisper
# TTS_PROVIDER=piper
# PIPER_API_URL=http://piper-tts:5001

# =============================================================================
# VARIÁVEIS DE BUSCA NA WEB (Tavily)
# =============================================================================

# Chave da API Tavily para busca na web (opcional)
TAVILY_API_KEY=your_tavily_api_key_here

# Habilita o serviço de busca na web (opcional, padrão: true se TAVILY_API_KEY estiver configurado)
WEB_SEARCH_ENABLED=true

# =============================================================================
# VARIÁVEIS DE MEMÓRIA (ChromaDB)
# =============================================================================

# Habilita memória de longo prazo (opcional, padrão: false)
MEMORY_ENABLED=false

# Caminho para armazenar dados do ChromaDB (opcional, padrão: ./data/chromadb)
CHROMADB_PATH=./data/chromadb

# Nome da coleção ChromaDB (opcional, padrão: tangerina_memory)
CHROMADB_COLLECTION_NAME=tangerina_memory

# Provedor de embeddings - 'sentence_transformers' (padrão) ou 'openai'
EMBEDDING_PROVIDER=openai

# Modelo de embedding OpenAI (opcional, padrão: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Modelo SentenceTransformer (opcional, padrão: all-MiniLM-L6-v2)
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Número máximo de memórias a recuperar (opcional, padrão: 10)
MAX_RETRIEVAL_RESULTS=10

# Limiar de similaridade para recuperação (opcional, padrão: 0.3)
MEMORY_SIMILARITY_THRESHOLD=0.3

# Dias de retenção de memórias (opcional, padrão: 30)
MEMORY_RETENTION_DAYS=30
