[run]
source = chatbot,features,flask_routes
omit =
    */tests/*
    */deploy/*
    */__pycache__/*
    .venv/*
    */venv/*
    chatbot/embedding_service.py
    chatbot/gemini_integration.py
    chatbot/model_helper.py
    chatbot/openai_integration.py
    chatbot/zhipu_integration.py
    features/music/music_bot.py
    features/tts/piper_tts.py
    features/tts/tts_handler.py

[report]
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
